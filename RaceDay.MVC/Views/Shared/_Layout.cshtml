<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <!-- Force Bootstrap to load -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: #f4f4f4;">
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #1a1a1a;">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" style="color: #ff9800;" asp-controller="Home" asp-action="Index">🏁 RaceDay</a>

            <!-- This forces the menu to show -->
            <div class="d-flex">
                <ul class="navbar-nav">
                    @if (Context.Session.GetString("UserRole") == "Participant")
                    {
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Participant" asp-action="Index">Events</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
                    }
                    @if (Context.Session.GetString("UserRole") == "Organiser")
                    {
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                    }

                    @if (Context.Session.GetString("JWTToken") != null)
                    {
                        <li class="nav-item"><a class="nav-link text-danger fw-bold" asp-controller="Account" asp-action="Logout">Logout</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Account" asp-action="Login">Login</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Account" asp-action="Register">Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
</body>
</html>