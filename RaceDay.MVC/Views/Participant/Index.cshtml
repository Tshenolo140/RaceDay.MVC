@model IEnumerable<RaceDay.MVC.Models.EventViewModel>
@{
    ViewData["Title"] = "Upcoming Events";
}
<h2>Upcoming Events</h2>

<div class="row mt-4">
    @foreach (var ev in Model)
    {
        <div class="col-md-4">
            <div class="card">
                @if (!string.IsNullOrEmpty(ev.BannerUrl))
                {
                    <img src="@ev.BannerUrl" class="card-img-top" style="height:150px; object-fit:cover;" alt="Event Banner">
                }
                <div class="card-body">
                    <h5 class="card-title">@ev.EventName</h5>
                    <p class="card-text">@ev.Location | @ev.EventDate.ToString("dd MMM yyyy")</p>
                    <button class="btn btn-primary w-100">Enrol Now</button>
                </div>
            </div>
        </div>
    }
</div>