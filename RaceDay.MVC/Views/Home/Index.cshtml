@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mt-5">
    <h1 class="display-3 fw-bold">Welcome to RaceDay</h1>
    <p class="lead mt-3">The ultimate platform for Organisers and Participants.</p>
    <hr class="my-4" style="width: 50%; margin: auto;" />
    <p>Ready to get started?</p>
    <a class="btn btn-primary btn-lg mt-3" asp-controller="Account" asp-action="Login">Login Now</a>
